# ─────────────────────────────────────────
# Owl CLI — Environment Configuration
# Copy this file to .env and fill in your values.
# You only need ONE of the LLM provider keys below.
# ─────────────────────────────────────────

# ── LLM Provider (optional) ──────────────
# Force a specific provider: anthropic | openai | grok | groq
# If not set, Owl auto-detects based on which key is present.
# OWL_PROVIDER=anthropic

# ── API Keys (add the one you want to use) ──
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROK_API_KEY=xai-...
GROQ_API_KEY=gsk_...

# ── Security ─────────────────────────────
# Pepper used to strengthen connection string encryption at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for production use. A default is used if unset (not recommended).
OWL_SERVER_PEPPER=your-random-32-byte-hex-string
